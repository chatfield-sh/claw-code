# ---- SHAI Core environment ----
# Copy to .env. Every value is optional in development: the API degrades to
# offline/heuristic behavior when keys are absent.

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://shai:shai@localhost:5432/shai

# Claude (agents + generic module). Without a key, agents use a heuristic fallback.
ANTHROPIC_API_KEY=
SHAI_MODEL=claude-sonnet-4-6

# Secret for signing OAuth state + encrypting stored Google tokens at rest.
# Generate a strong value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
SHAI_SECRET_KEY=dev-insecure-change-me

# Clerk (auth). Without keys, the API resolves a single dev tenant/user.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Google connectors (read + draft + calendar read). Optional for the scaffold.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/google/callback

# The single dev tenant/user seeded by db/seed.sql (used when Clerk is absent).
SHAI_DEV_TENANT_ID=00000000-0000-0000-0000-000000000001
SHAI_DEV_USER_ID=00000000-0000-0000-0000-000000000002

# Web -> API base URL
NEXT_PUBLIC_API_BASE=http://localhost:8000
